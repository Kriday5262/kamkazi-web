# Copy to .env and adjust as needed.

# Postgres connection used by Drizzle, migrations and the seed script.
# Local dev (docker-compose.dev.yml maps port 5433 -> 5432):
DATABASE_URL=postgres://kamkazi:kamkazi@localhost:5433/kamkazi

# Secret used to sign the session cookie (HMAC). Change this to a long random
# string in any shared environment: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me

# --- Stage 3: AI providers (all optional; defaults shown) ---
# Hermes local OpenAI-compatible endpoint (default provider).
# NOTE: from inside the app container, use the host LAN IP — host.docker.internal
# does not resolve in this container.
HERMES_BASE_URL=http://192.168.29.188:11436/v1

# OpenAI fallback (used when Settings > AI provider = openai). Can also be set
# per-user in Settings inside the app.
OPENAI_API_KEY=sk-...

# Ollama fallback (provider = ollama). Default: http://192.168.29.188:11434/v1
# OLLAMA_BASE_URL=http://192.168.29.188:11434/v1

# --- Stage 4.5: Google Calendar OAuth (optional) ---
# OAuth client for read-only Google Calendar sync. Preferred setup is via
# Settings > Calendar > Google Calendar inside the app (stored per-user);
# these env vars are a server-wide fallback. See GOOGLE_OAUTH_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=