# Copy to .env and adjust. Used by docker-compose.prod.yml. DO NOT COMMIT real secrets.

# Secret used to sign the session cookie (HMAC). Required - compose refuses to
# start without it. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# Login credentials (defaults to the Stage-1 values below).
KAMKAZI_USERNAME=Shantanu
KAMKAZI_PASSWORD=SmartHome@2012

# Only needed if running scripts/backup-db.sh or migrations from the host
# against something other than the prod compose Postgres (127.0.0.1:5434).
# DATABASE_URL=postgres://kamkazi:kamkazi@127.0.0.1:5434/kamkazi